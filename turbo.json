{
	"$schema": "https://turbo.build/schema.json",
	"pipeline": {
		"cannoli-plugin": {
			"outputs": ["../../main.js"]
		},
		"build": {
			"outputs": ["dist"],
			"dependsOn": ["^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		},
		"typecheck": {},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"release": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"build-college": {
			"cache": false
		}
	}
}
